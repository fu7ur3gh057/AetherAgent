# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram user ID(s) через запятую. Только они могут писать боту.
ALLOWED_USER_IDS=

# LLM: claude | gemini
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres (внутри docker-сети, наружу не торчит)
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aether

# Сколько последних сообщений отдавать модели
HISTORY_LIMIT=30
