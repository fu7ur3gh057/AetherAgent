# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram user ID(s) через запятую. Только они могут писать боту.
ALLOWED_USER_IDS=

# LLM: claude | gemini
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres (внутри docker-сети, наружу не торчит)
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aether

# Сколько последних сообщений отдавать модели
HISTORY_LIMIT=30

# Часовой пояс (IANA), например Asia/Baku, Europe/Moscow, UTC
TIMEZONE=UTC

# Утренняя сводка почты: время HH:MM в твоём часовом поясе. Пусто = выключено
DIGEST_TIME=
# Дни недели для сводки: 1=пн ... 7=вс
DIGEST_DAYS=1,2,3,4,5,6,7

# Голосовые сообщения. STT_PROVIDER: пусто = авто (gemini при наличии GEMINI_API_KEY), gemini | whisper | off
STT_PROVIDER=
# gemini: модель (по умолчанию GEMINI_MODEL); whisper: tiny | base | small | medium (по умолчанию small)
STT_MODEL=
VOICE_MAX_SECONDS=300
# Локальный Whisper: собрать образ с faster-whisper (WITH_WHISPER=1) и STT_PROVIDER=whisper
WITH_WHISPER=0
WHISPER_CPU_THREADS=2
