# Telegram
TELEGRAM_BOT_TOKEN=
# Telegram user ID(s) через запятую. Только они могут писать боту.
ALLOWED_USER_IDS=

# LLM: claude | gemini
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Postgres (внутри docker-сети, наружу не торчит)
POSTGRES_USER=aether
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aether

# Сколько последних сообщений отдавать модели
HISTORY_LIMIT=30

# Часовой пояс (IANA), например Asia/Baku, Europe/Moscow, UTC
TIMEZONE=UTC

# Утренняя сводка почты: время HH:MM в твоём часовом поясе. Пусто = выключено
DIGEST_TIME=
# Дни недели для сводки: 1=пн ... 7=вс
DIGEST_DAYS=1,2,3,4,5,6,7

# Голосовые сообщения. STT_PROVIDER: пусто = авто (whisper, если установлен, иначе gemini), whisper | gemini | off
STT_PROVIDER=whisper
# whisper: tiny | base | small | medium (small: хорошее качество по-русски, ~1 ГБ памяти)
STT_MODEL=small
# Запасной распознаватель, если Whisper упал: gemini | off. gemini отправляет аудио в Google; off = только локально
STT_FALLBACK=gemini
VOICE_MAX_SECONDS=300
# Собирать образ с локальным Whisper (1 = да). Образ тяжелее; при 0 останется только Gemini
WITH_WHISPER=1
WHISPER_CPU_THREADS=2

# Контроль резервных копий: бот раз в день (HH:MM в TIMEZONE) проверяет свежесть копии и пишет, если она устарела. Пусто = выключено
BACKUP_CHECK_TIME=09:00
BACKUP_MAX_AGE_HOURS=36

# Дневной лимит токенов (вход + выход, все модели); 0 = без лимита. На 80% бот предупреждает, на 100% не вызывает модель
DAILY_TOKEN_LIMIT=500000

# Сообщение при каждом запуске бота (видно рестарты и деплои)
STARTUP_NOTICE=true

# Ежедневная проверка здоровья (токен Google и т.п.): HH:MM в TIMEZONE; пусто = выключено
HEALTH_CHECK_TIME=09:05
# Срок жизни токена Google в режиме Testing (дни); за 2 дня до него бот предупреждает. 0 = не предупреждать
GOOGLE_TOKEN_MAX_AGE_DAYS=7
